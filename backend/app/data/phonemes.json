{
  "phonemes": [
    {
      "ipa": "iː",
      "examples": ["sheep", "see", "eat"],
      "common_error": "ɪ",
      "note": "长元音，舌位更前更高，口型略展"
    },
    {
      "ipa": "ɪ",
      "examples": ["ship", "sit", "it"],
      "common_error": "iː",
      "note": "短元音，舌位略低，时长更短"
    },
    {
      "ipa": "æ",
      "examples": ["cat", "apple", "hat"],
      "common_error": "e",
      "note": "开口更大，舌位靠前靠下"
    },
    {
      "ipa": "e",
      "examples": ["bed", "pen", "red"],
      "common_error": "æ",
      "note": "开口小于 /æ/，舌位略高"
    },
    {
      "ipa": "ʌ",
      "examples": ["cup", "sun", "but"],
      "common_error": "ɑː",
      "note": "短元音，口型自然放松"
    },
    {
      "ipa": "ə",
      "examples": ["the", "about", "banana"],
      "common_error": "ʌ",
      "note": "最放松的弱读音"
    },
    {
      "ipa": "ɑː",
      "examples": ["car", "father", "arm"],
      "common_error": "ʌ",
      "note": "开口靠后，声音拉长"
    },
    {
      "ipa": "ɔː",
      "examples": ["ball", "four", "door"],
      "common_error": "ɒ",
      "note": "圆唇长音，嘴型更圆"
    },
    {
      "ipa": "ʊ",
      "examples": ["book", "put", "good"],
      "common_error": "uː",
      "note": "短圆唇，不要拉得太长"
    },
    {
      "ipa": "uː",
      "examples": ["food", "blue", "two"],
      "common_error": "ʊ",
      "note": "双唇收圆，声音拉长"
    },
    {
      "ipa": "ɜː",
      "examples": ["bird", "nurse", "her"],
      "common_error": "ə",
      "note": "舌头略卷，声音拉长"
    },
    {
      "ipa": "aɪ",
      "examples": ["light", "like", "my"],
      "common_error": "æ",
      "note": "从开口滑向展唇"
    },
    {
      "ipa": "eɪ",
      "examples": ["day", "name", "say"],
      "common_error": "e",
      "note": "从 /e/ 滑向 /ɪ/"
    },
    {
      "ipa": "oʊ",
      "examples": ["go", "home", "no"],
      "common_error": "ɔː",
      "note": "圆唇再收得更小"
    },
    {
      "ipa": "θ",
      "examples": ["think", "three", "thank"],
      "common_error": "s",
      "note": "舌尖轻触上齿，送气摩擦"
    },
    {
      "ipa": "ð",
      "examples": ["this", "that", "the"],
      "common_error": "z",
      "note": "与 /θ/ 同部位，声带振动"
    },
    {
      "ipa": "ʃ",
      "examples": ["sheep", "shoe", "fish"],
      "common_error": "s",
      "note": "双唇略突，气流从舌面通过"
    },
    {
      "ipa": "s",
      "examples": ["see", "sun", "bus"],
      "common_error": "ʃ",
      "note": "舌尖靠近齿龈，不要圆唇"
    },
    {
      "ipa": "z",
      "examples": ["zoo", "is", "has"],
      "common_error": "s",
      "note": "部位同 /s/，要发出声音"
    },
    {
      "ipa": "v",
      "examples": ["very", "five", "have"],
      "common_error": "w",
      "note": "上齿轻咬下唇，不要发成 we"
    },
    {
      "ipa": "w",
      "examples": ["we", "water", "what"],
      "common_error": "v",
      "note": "双唇收圆，不要碰到牙齿"
    },
    {
      "ipa": "f",
      "examples": ["five", "fish", "off"],
      "common_error": "v",
      "note": "上齿轻触下唇，送气不振动"
    },
    {
      "ipa": "l",
      "examples": ["light", "like", "hello"],
      "common_error": "r",
      "note": "舌尖抵上齿龈"
    },
    {
      "ipa": "r",
      "examples": ["red", "right", "run"],
      "common_error": "l",
      "note": "舌尖上卷，不碰齿龈"
    },
    {
      "ipa": "ŋ",
      "examples": ["think", "sing", "long"],
      "common_error": "n",
      "note": "舌头后部抬高，声音走鼻子"
    },
    {
      "ipa": "tʃ",
      "examples": ["chair", "much", "cheese"],
      "common_error": "ʃ",
      "note": "先堵住再送气，像中文「七」但更圆"
    },
    {
      "ipa": "dʒ",
      "examples": ["jump", "orange", "job"],
      "common_error": "d",
      "note": "和 /tʃ/ 同部位，要发出声音"
    },
    {
      "ipa": "p",
      "examples": ["pen", "apple", "ship"],
      "common_error": "b",
      "note": "双唇闭上再送气打开"
    },
    {
      "ipa": "t",
      "examples": ["cat", "tea", "hat"],
      "common_error": "d",
      "note": "舌尖点上牙后面再松开"
    },
    {
      "ipa": "k",
      "examples": ["cat", "key", "book"],
      "common_error": "g",
      "note": "舌头后部堵住再放开"
    },
    {
      "ipa": "d",
      "examples": ["red", "dog", "bed"],
      "common_error": "t",
      "note": "舌尖位置和 /t/ 一样，要出声"
    },
    {
      "ipa": "n",
      "examples": ["no", "sun", "name"],
      "common_error": "ŋ",
      "note": "舌尖抵上齿龈，声音走鼻子"
    },
    {
      "ipa": "h",
      "examples": ["hat", "hello", "house"],
      "common_error": "",
      "note": "嘴巴保持后面元音的口型，轻轻哈气"
    }
  ]
}
